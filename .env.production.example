# Core data plane
POSTGRES_DB=astraos
POSTGRES_USER=astraos
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://astraos:change-me@postgres:5432/astraos
NATS_URL=nats://nats:4222

# Service auth + RBAC
AUTH_ISSUER_URL=https://auth.example.com/
AUTH_AUDIENCE=astraos-api
RBAC_POLICY_FILE=/app/config/rbac/policy.csv

# Telemetry
OTEL_SERVICE_NAME=initiation_kernel
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
PROMETHEUS_ENABLED=true

# Dashboard API integration
NEXT_PUBLIC_SOVEREIGN_API=http://localhost:8080

# Grafana bootstrap
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
